<?xml version="1.0" encoding="UTF-8"?>

<beans xmlns="http://www.springframework.org/schema/beans"
	xmlns:context="http://www.springframework.org/schema/context"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="
        http://www.springframework.org/schema/beans
        http://www.springframework.org/schema/beans/spring-beans.xsd
        http://www.springframework.org/schema/context
        http://www.springframework.org/schema/context/spring-context.xsd">

	<!-- Service 스캔 -->
	<context:component-scan base-package="com.springmvc.service">
    <context:exclude-filter
        type="regex"
        expression="com\.springmvc\.service\.kakao\.KakaoLocalService" />
</context:component-scan>

	<!-- Repository 스캔 -->
	<context:component-scan
		base-package="com.springmvc.repository" />

	<!-- Component가 따로 있으면 추가 -->
	<context:component-scan
		base-package="com.springmvc.util" />

	<!-- DB 연결 -->
	<bean id="dataSource"
		class="org.springframework.jdbc.datasource.DriverManagerDataSource">

		<!-- MySQL 8.x 드라이버 -->
		<property name="driverClassName"
			value="com.mysql.cj.jdbc.Driver" />

		<!-- AWS RDS MySQL 연결 URL -->
		<property name="url"
			value="jdbc:mysql://database.c5s8mqcqwxjg.ap-northeast-2.rds.amazonaws.com:3306/Eat?allowPublicKeyRetrieval=true&amp;useSSL=false&amp;serverTimezone=Asia/Seoul" />

		<property name="username" value="admin" />

		<property name="password" value="eks3292929!" />
	</bean>

	<!-- JdbcTemplate -->
	<bean id="jdbcTemplate"
		class="org.springframework.jdbc.core.JdbcTemplate">
		<property name="dataSource" ref="dataSource" />
	</bean>

	<!-- 메시지 소스 -->
	<bean id="messageSource"
		class="org.springframework.context.support.ResourceBundleMessageSource">
		<property name="basename" value="messages" />
		<property name="defaultEncoding" value="UTF-8" />
	</bean>

	<!-- Validator -->
	<bean id="validator"
		class="org.springframework.validation.beanvalidation.LocalValidatorFactoryBean">
		<property name="validationMessageSource" ref="messageSource" />
	</bean>

</beans>